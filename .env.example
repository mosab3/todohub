# Copy to .env for local development.
#
# Vite exposes only variables prefixed with VITE_ to client code, and any
# VITE_* value is baked into the built HTML/JS at build time - so treat these
# as public. Do not put API keys or secrets here.

# AdSense publisher ID, injected into index.html by the `head-meta` plugin in
# vite.config.ts. When unset, the AdSense script tag is dropped instead of
# shipping a broken `ca-pub-%VITE_ADSENSE_PUB%` placeholder.
#
# On Netlify: Site configuration -> Environment variables -> VITE_ADSENSE_PUB
# Changing it requires a redeploy, because it is read at build time.
VITE_ADSENSE_PUB=

# Absolute base URL of the deployed site. Used for the canonical link and the
# og:url / og:image link-preview tags, which crawlers need to be absolute.
#
# Netlify already exposes this as `URL` during builds, so on Netlify you can
# leave it blank. Set it to override, for example a custom domain:
# VITE_SITE_URL=https://todohub.example.com
VITE_SITE_URL=
